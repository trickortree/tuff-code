mention tgame

# 2D physics: a ball bounces on a floor (lower each time), a box falls and lands, a plank tips over, and the
# window's edges are walls.
game = tgame.window("Bouncy", 800, 600)
game:gravity(900)
game:walls(true)
floor = game:box(400, 580, 800, 40, "gray"):physics("static")
ball = game:circle(200, 100, 20, "red"):physics()
ball:bounce(0.8)
box = game:box(600, 200, 60, 60, "orange"):physics()
box:mass(3)
plank = game:line(330, 300, 470, 300, "white"):physics()
hits = 0
floor_hits = 0

func boing(other, strength):
    hits += 1
    if other is floor:
        floor_hits += 1

ball:on_hit boing

func report():
    say "ball " + ball:spot() + " hits " + hits + " on the floor " + floor_hits
    say "box " + box:spot() + " angle " + round(box:angle())

func kick():
    ball:push(200, -300)
